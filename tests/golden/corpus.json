{
  "version": 1,
  "description": "M3 golden corpus: replays and frames for Classic (pixel-identical), Enhanced, each layout, a battle and a menu, plus interaction-matrix assertions.",
  "rom": "rom/dq9.nds",
  "rtc": 1760000000,
  "default_frames": 300,
  "settings_defaults": {
    "mode": "classic"
  },
  "option_to_key": {
    "mode": "mode",
    "render_scale": "render_scale",
    "smooth_textures": "smooth_textures",
    "outlines": "outlines",
    "soft_shadows": "soft_shadows",
    "smooth_shading": "smooth_shading",
    "hd_text": "hd_text",
    "hd_text_shadows": "hd_text_shadows",
    "texture_packs": "texture_packs",
    "music_packs": "music_packs",
    "music_song_names": "music_song_names",
    "transmog": "transmog",
    "dslite_filter": "dslite_filter",
    "lcd_colors": "lcd_colors",
    "pixel_grid": "pixel_grid",
    "motion_blur": "motion_blur",
    "backlight": "backlight",
    "screen_gap": "screen_gap",
    "console": "console",
    "integer_scaling": "integer_scaling",
    "actual_size": "actual_size",
    "layout": "layout",
    "single_screen": "single_screen",
    "widescreen_popout": "widescreen_popout",
    "widescreen_battle_hud": "widescreen_battle_hud",
    "walk_any_direction": "walk_any_direction",
    "upscale_textures": "upscale_textures",
    "music_pack_volume": "music_pack_volume",
    "discord": "discord"
  },
  "crc_scope": "One line per frame: frame number and a 64-bit hash of engine A's composed 256x192 picture (runtime/gpu2d.c writes it from g_screen). It contains nothing that is drawn after composition: no GL post-process (DS Lite filter), no HD letter atlas, no window layout. Options in that class must leave it byte-identical; their own effect is checked with DQIX_GL_DUMP on a GL-capable machine.",
  "cases": [
    { "id": "classic_title", "description": "Classic mode, default layout, title screen (pixel-identical reference)", "frames": 300, "settings": { "mode": "classic" }, "input": "", "tags": ["classic", "title"] },
    { "id": "classic_enhanced_opts", "description": "Classic mode with every enhanced option forced on (must be ignored)", "frames": 300, "settings": { "mode": "classic", "smooth_textures": 1, "outlines": "medium", "soft_shadows": 1, "smooth_shading": 1, "hd_text": 1, "hd_text_shadows": 1, "texture_packs": 1, "music_packs": 1, "transmog": 1, "upscale_textures": 1, "widescreen_battle_hud": 1, "layout": "wide_dynamic" }, "input": "", "tags": ["classic", "interaction"] },
    { "id": "classic_wide", "description": "Classic mode with widescreen requested (must be ignored)", "frames": 300, "settings": { "mode": "classic", "layout": "wide" }, "input": "", "tags": ["classic", "interaction"] },
    { "id": "enhanced_title", "description": "Enhanced mode, default layout, title screen", "frames": 300, "settings": { "mode": "enhanced" }, "input": "", "tags": ["enhanced", "title"] },
    { "id": "enhanced_wide", "description": "Enhanced + Basic Widescreen", "frames": 300, "settings": { "mode": "enhanced", "layout": "wide" }, "input": "", "tags": ["enhanced", "layout"] },
    { "id": "enhanced_dynwide", "description": "Enhanced + Dynamic Widescreen", "frames": 300, "settings": { "mode": "enhanced", "layout": "wide_dynamic" }, "input": "", "tags": ["enhanced", "layout", "experimental"] },
    { "id": "enhanced_hdtext", "description": "Enhanced + HD text", "frames": 300, "settings": { "mode": "enhanced", "hd_text": 1 }, "input": "", "tags": ["enhanced", "hd_text"] },
    { "id": "enhanced_hdtext_shadows", "description": "Enhanced + HD text + HD text shadows", "frames": 300, "settings": { "mode": "enhanced", "hd_text": 1, "hd_text_shadows": 1 }, "input": "", "tags": ["enhanced", "hd_text", "experimental"] },
    { "id": "enhanced_filter", "description": "Enhanced + DS Lite filter (default on)", "frames": 300, "settings": { "mode": "enhanced", "dslite_filter": 1, "lcd_colors": 1 }, "input": "", "tags": ["enhanced", "filter"] },
    { "id": "enhanced_filter_nocolor", "description": "Enhanced + DS Lite filter without LCD colours", "frames": 300, "settings": { "mode": "enhanced", "dslite_filter": 1, "lcd_colors": 0 }, "input": "", "tags": ["enhanced", "filter", "interaction"] },
    { "id": "layout_stacked", "description": "Layout: stacked (default)", "frames": 300, "settings": { "mode": "enhanced", "layout": "stacked" }, "input": "", "tags": ["layout"] },
    { "id": "layout_sidebyside", "description": "Layout: side by side", "frames": 300, "settings": { "mode": "enhanced", "layout": "side_by_side" }, "input": "", "tags": ["layout"] },
    { "id": "layout_corner", "description": "Layout: top screen in corner", "frames": 300, "settings": { "mode": "enhanced", "layout": "corner" }, "input": "", "tags": ["layout"] },
    { "id": "layout_twowindows", "description": "Layout: two windows", "frames": 300, "settings": { "mode": "enhanced", "layout": "two_windows" }, "input": "", "tags": ["layout"] },
    { "id": "layout_wide_basic", "description": "Layout: Basic Widescreen", "frames": 300, "settings": { "mode": "enhanced", "layout": "wide" }, "input": "", "tags": ["layout", "widescreen"] },
    { "id": "layout_wide_dynamic", "description": "Layout: Dynamic Widescreen", "frames": 300, "settings": { "mode": "enhanced", "layout": "wide_dynamic" }, "input": "", "tags": ["layout", "widescreen", "experimental"] },
    { "id": "widescreen_single", "description": "Widescreen + single_screen (widescreen wins: small screen hidden)", "frames": 300, "settings": { "mode": "enhanced", "layout": "wide", "single_screen": 1 }, "input": "", "tags": ["widescreen", "interaction"] },
    { "id": "widescreen_battlehud", "description": "Widescreen + battle HUD over the 3D", "frames": 300, "settings": { "mode": "enhanced", "layout": "wide", "widescreen_battle_hud": 1 }, "input": "", "tags": ["widescreen", "experimental"] },
    { "id": "battle", "description": "A battle: scripted input reaches the first battle", "frames": 900, "settings": { "mode": "enhanced" }, "input": "120:A:1;200:A:1;260:A:1;320:A:1;400:A:1;500:A:1;600:A:1;700:A:1", "tags": ["battle"] },
    { "id": "menu", "description": "An in-game menu open", "frames": 400, "settings": { "mode": "enhanced" }, "input": "180:START:1;200:DOWN:3;220:A:1", "tags": ["menu"] }
  ],
  "matrix": [
    { "combo": "Classic x any enhanced option", "case_a": "classic_title", "case_b": "classic_enhanced_opts", "assertion": "crc_equal", "note": "enhanced options ignored in Classic" },
    { "combo": "Classic x widescreen", "case_a": "classic_title", "case_b": "classic_wide", "assertion": "crc_equal", "note": "widescreen disabled in Classic" },
    { "combo": "dslite_filter x lcd_colors", "case_a": "enhanced_filter", "case_b": "enhanced_filter_nocolor", "assertion": "crc_equal_postprocess", "note": "the colour correction is a fragment shader over the composed screens (gl_render.c, u_lcdcolor): the emulated framebuffer is untouched, so the CRCs must match" },
    { "combo": "hd_text x hd_text_shadows", "case_a": "enhanced_hdtext", "case_b": "enhanced_hdtext_shadows", "assertion": "crc_equal_postprocess", "note": "shadows are decided when the HD letters are drawn by the GL pass (text_hd.c g_tx_shadows): without GL nothing is redrawn, and the DS picture stays the same" },
    { "combo": "widescreen x single_screen", "case_a": "layout_wide_basic", "case_b": "widescreen_single", "assertion": "crc_equal_postprocess", "note": "widescreen wins (single = g_single && !wide), so single_screen changes which screen the window shows, not what the consoles draw" }
  ],
  "assertions": {
    "crc_equal": "The two cases' frame CRC files are byte-identical (Classic stays pixel-identical / option ignored).",
    "crc_differs": "The two cases' frame CRC files differ (the option changes the composed framebuffer).",
    "crc_equal_postprocess": "The two cases' frame CRC files are byte-identical *because the option is applied after composition* (GL shader, GL letter pass, window layout). Identity is the requirement, not an accident: such an option must never reach into the emulated framebuffer. Its own effect is out of the CRC's reach and is checked with DQIX_GL_DUMP on a GL-capable machine.",
    "frame_exists": "At least one .ppm frame was captured for the case.",
    "crc_nonempty": "The case's CRC file is non-empty."
  }
}